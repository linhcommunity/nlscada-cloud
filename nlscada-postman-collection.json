              "host": ["{{base_url}}"],
              "path": ["v1", "sites", "{{site_id}}", "devices", "{{device_id}}"]
            }
          }
        },
        {
          "name": "Viewer tries to invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (!pm.environment.get('site_id')) {",
                  "    pm.expect.fail('site_id is not set.');",
                  "}",
                  "pm.test('Status 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user2_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fake@example.com\",\n  \"role\": \"viewer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sites/{{site_id}}/members",
              "host": ["{{base_url}}"],
              "path": ["v1", "sites", "{{site_id}}", "members"]
            }
          }
        }
      ]
    }
