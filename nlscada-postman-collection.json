{
  "info": {
    "name": "NL SCADA Center v1.0",
    "description": "Postman Collection để test toàn bộ API của NL SCADA Center v1.0.\n\nBiến môi trường cần thiết:\n- base_url: http://localhost:8080\n- token: (tự động lưu sau khi login)\n- site_id: (tự động lưu sau khi tạo site)\n- device_id: (tự động lưu sau khi tạo device)\n- user2_token: (token của user thứ 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register User 1 (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.environment.set('user1_email', 'admin_test@example.com');",
                  "pm.environment.set('user1_password', 'Admin@123');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin_test@example.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user1_email}}\",\n  \"password\": \"{{user1_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get My Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["v1", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Sites & Memberships",
      "item": [
        {
          "name": "Create Site",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.environment.set('site_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Factory\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sites",
              "host": ["{{base_url}}"],
              "path": ["v1", "sites"]
            }
          }
        },
        {
          "name": "List My Sites",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Contains site', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array').with.lengthOf.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/sites",
              "host": ["{{base_url}}"],
              "path": ["v1", "sites"]
            }
          }
        },
        {
          "name": "Register User 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.environment.set('user2_email', 'viewer_test@example.com');",
                  "pm.environment.set('user2_password', 'Viewer@123');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"viewer_test@example.com\",\n  \"password\": \"Viewer@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.environment.set('user2_token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user2_email}}\",\n  \"password\": \"{{user2_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Invite User 2 to Site",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (!pm.environment.get('site_id')) {",
                  "    pm.expect.fail('site_id is not set. Please run Create Site first.');",
                  "}",
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user2_email}}\",\n  \"role\": \"viewer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sites/{{site_id}}/members",
              "host": ["{{base_url}}"],
              "path": ["v1", "sites", "{{site_id}}", "members"]
            }
          }
        },
        {
          "name": "List Members",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (!pm.environment.get('site_id')) {",
                  "    pm.expect.fail('site_id is not set. Please run Create Site first.');",
                  "}",
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('2 members', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array').with.lengthOf(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/sites/{{site_id}}/members",
              "host": ["{{base_url}}"],
              "path": ["v1", "sites", "{{site_id}}", "members"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Devices & Tags",
      "item": [
        {
          "name": "Create Device",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (!pm.environment.get('site_id')) {",
                  "    pm.expect.fail('site_id is not set. Please run Create Site first.');",
                  "}",
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.environment.set('device_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Temperature Sensor\",\n  \"device_type\": \"virtual\",\n  \"mqtt_client_id\": \"sensor-001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sites/{{site_id}}/devices",
              "host": ["{{base_url}}"],
              "path": ["v1", "sites", "{{site_id}}", "devices"]
            }
          }
        },
        {
          "name": "List Devices",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (!pm.environment.get('site_id')) {",
                  "    pm.expect.fail('site_id is not set. Please run Create Site first.');",
                  "}",
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/sites/{{site_id}}/devices",
              "host": ["{{base_url}}"],
              "path": ["v1", "sites", "{{site_id}}", "devices"]
            }
          }
        },
        {
          "name": "Create Tag",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (!pm.environment.get('site_id') || !pm.environment.get('device_id')) {",
                  "    pm.expect.fail('site_id or device_id not set.');",
                  "}",
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"temperature\",\n  \"data_type\": \"float\",\n  \"unit\": \"°C\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sites/{{site_id}}/devices/{{device_id}}/tags",
              "host": ["{{base_url}}"],
              "path": ["v1", "sites", "{{site_id}}", "devices", "{{device_id}}", "tags"]
            }
          }
        },
        {
          "name": "Viewer tries to create device (should fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (!pm.environment.get('site_id')) {",
                  "    pm.expect.fail('site_id is not set.');",
                  "}",
                  "pm.test('Status 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user2_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fake Device\",\n  \"device_type\": \"virtual\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/sites/{{site_id}}/devices",
              "host": ["{{base_url}}"],
              "path": ["v1", "sites", "{{site_id}}", "devices"]
            }
          }
        }
      ]
    },
    {
